# Public template only. Copy to .env and replace XXX on your machine.
PORT=4317
HOST=127.0.0.1
LLM_BASE_URL=XXX
LLM_API_KEY=XXX
LLM_MODEL=XXX
TAVILY_API_KEY=XXX
SEARCH_PROVIDER=XXX

# Actual SDK MCP memory transport by default; direct is an explicit debug fallback.
PRISM_TOOL_TRANSPORT=mcp

# Optional additional search discovery. The instance must enable JSON search.
# SEARXNG_URL=http://127.0.0.1:4330
# SEARXNG_ENGINES=bingrss
# Optional existing Crawl4AI service for public dynamic product pages.
# CRAWL4AI_URL=http://127.0.0.1:11235
# CRAWL4AI_API_TOKEN=XXX

# Optional Redis search cache. XXX leaves it disabled; never commit a real URL/password.
REDIS_URL=XXX
REDIS_SEARCH_TTL_SECONDS=300
REDIS_CACHE_TIMEOUT_MS=300
