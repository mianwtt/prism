{
  "name": "prism-decision",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed research and interactive decision workspace",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:project": "node scripts/check-project.mjs",
    "check:publish": "node scripts/check-secrets.mjs && node scripts/check-project.mjs --index",
    "package:source": "node scripts/package-source.mjs",
    "test:browser": "playwright test",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "test:agent:local": "node --env-file-if-exists=.env scripts/smoke-agent.mjs",
    "setup:search": "node scripts/setup-tofu.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "test:release": "npm run check && npm test && npm run test:browser",
    "evaluate:evidence": "node scripts/evaluate-evidence.mjs",
    "probe:research": "node --env-file-if-exists=.env scripts/probe-research.mjs",
    "test:adaptive:live": "node --env-file-if-exists=.env scripts/smoke-adaptive-live.mjs"
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3": true
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "es-module-lexer": "3.0.5"
  },
  "dependencies": {
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@langchain/ollama": "1.3.0",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  }
}
